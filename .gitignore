# Binaries (root-level build artifacts only; do not match cmd/ packages)
/bin/
/grimoire
/grimoire-cli
*.exe

# Go
*.test
*.out
coverage.*

# Local
*.db
*.sqlite
*.sqlite3
.env
*.local.yaml

# Editor / OS
.DS_Store
.idea/
.vscode/

# Node build artifacts
web/theme/node_modules/

# Local preview runtime (db, logs)
/data/

# Local agent / analysis tooling
# Per-machine tool config and generated analysis output, not shared project
# state. .scout/scout.config.yaml was previously committed by accident (swept
# into 0277754, an unrelated postgres placeholder fix) and is untracked as of
# this change.
.opencode/
.scout/
.kiro/
graphify-out/

# Spec task-tool run state. Lives under plans/ because .kiro/specs symlinks
# there, so the .kiro/ rule above does not reach it. Contents are per-run and
# per-machine (execution ids, chat session ids, wall-clock timestamps) and
# record nothing that tasks.md does not already capture.
plans/**/tasks.meta.json
