{{define "title"}}Log in — {{.SiteTitle}}{{end}}
{{define "content"}}
<h1>Log in</h1>
{{if .Error}}<p role="alert">Invalid username or password.</p>{{end}}
<form method="post" action="/login">
  <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
  <input type="hidden" name="redirect" value="{{.Redirect}}">
  <p>
    <label for="log">Username</label>
    <input id="log" name="log" type="text" autocomplete="username" autofocus>
  </p>
  <p>
    <label for="pwd">Password</label>
    <input id="pwd" name="pwd" type="password" autocomplete="current-password">
  </p>
  <p><button type="submit">Log in</button></p>
</form>
{{end}}
