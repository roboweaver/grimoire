{{define "title"}}{{.Heading}} · {{.SiteTitle}}{{end}}
{{define "content"}}
<div class="theme-page-head">
<h1 class="spectrum-Heading spectrum-Heading--sizeXL">{{.Heading}}</h1>
</div>
<div class="theme-card-grid">
{{range .Posts}}
{{template "post-card" .}}
{{else}}
<p class="spectrum-Body spectrum-Body--sizeM">Nothing here yet.</p>
{{end}}
</div>
{{if gt .Pagination.TotalPages 1}}
<nav class="theme-pagination" aria-label="Posts pagination">
<p class="spectrum-Body spectrum-Body--sizeS">Page {{.Pagination.Page}} of {{.Pagination.TotalPages}}</p>
{{if .PrevURL}}<a href="{{.PrevURL}}" class="spectrum-Link">Previous</a>{{end}}
{{if .NextURL}}<a href="{{.NextURL}}" class="spectrum-Link">Next</a>{{end}}
</nav>
{{end}}
{{end}}
