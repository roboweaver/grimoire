{{define "title"}}{{.Term.Name}} · {{.SiteTitle}}{{end}}
{{define "content"}}
<div class="theme-page-head">
<h1 class="spectrum-Heading spectrum-Heading--sizeXL">{{.Term.Name}}</h1>
</div>
<div class="theme-card-grid">
{{range .Posts}}
{{template "post-card" .}}
{{else}}
<p class="spectrum-Body spectrum-Body--sizeM">No posts in this category yet.</p>
{{end}}
</div>
{{end}}
